# The Rust service image (docker/Dockerfile) only needs the workspace sources;
# everything below is irrelevant to that build and only bloats the build context
# (slower transfers + memory pressure during unpack).

# Rust build artifacts.
target/

# Local stack runtime state: bind-mounted Delta tables, Postgres data, etc.
# Created by docker compose / local runs; never an input to a build.
**/.data/
.uc-data/
.open-lakehouse/
.hydro/

# VCS and editor noise.
.git/
.github/

# Docs and notebooks.
docs/
notebooks/
spark-warehouse/
