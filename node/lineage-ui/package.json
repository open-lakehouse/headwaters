{
  "name": "@open-lakehouse/lineage-ui",
  "version": "0.0.0",
  "description": "React components for the headwaters lineage read API: graph canvas, browsers, detail panels, search and stats, bound through the @open-lakehouse/host contract",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/headwaters.git",
    "directory": "node/lineage-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/testing",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "headwaters-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@open-lakehouse/lineage-client": "*",
    "@tanstack/react-query": "^5.100.0",
    "@xyflow/react": "^12.4.0",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.0",
    "lucide-react": "^1.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@open-lakehouse/host": "0.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@connectrpc/connect": "^2.1.0",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.2/open-lakehouse-host-0.0.2.tgz",
    "@storybook/react": "^8.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
